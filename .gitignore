project.xcworkspace/xcuserdata/
project.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings

# Swift Package Manager
#
.build/
.swiftpm/
Packages/
Package.pins

# CocoaPods
#
Pods/

# Carthage
#
Carthage/Build/

